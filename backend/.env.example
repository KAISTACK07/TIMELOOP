# TimeLoop backend configuration — copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real keys, and never expose them to the frontend.

# --- Phase 7: AI Explainer (optional) ---
# When set, /explain uses Claude. When unset, /explain falls back to the
# deterministic AST static analyzer (still fully functional, no key needed).
ANTHROPIC_API_KEY=

# Model used by the AI Explainer. Defaults to claude-opus-5.
# TIMELOOP_AI_MODEL=claude-opus-5

# --- CORS ---
# Comma-separated allowed origins for production. Defaults to "*" (dev only).
# TIMELOOP_ALLOWED_ORIGINS=https://your-frontend.example.com
